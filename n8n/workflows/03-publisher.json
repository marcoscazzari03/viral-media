    {
      "id": "2f33c3c2-2dc8-4d06-8aed-d16a3c6e81be",
      "name": "Init Publisher",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Init Publisher — run context + typed config (viral_config). Missing keys fall back to DEFAULTS.\n\nconst DEFAULTS = {\n  ig_user_id: '',\n  ig_api_version: 'v23.0',\n  publish_enabled: 0,\n  publish_slots_et: '11,15,19',\n  publish_max_per_day: 1,\n  publish_min_gap_h: 3,\n  publish_ready_max_age_h: 36,\n  publish_force_post_key: '',\n};\n\nconst warnings = [];\nconst config = { ...DEFAULTS };\nfor (const item of $input.all()) {\n  const r = item.json;\n  const key = String(r.key ?? '').trim();\n  if (!(key in DEFAULTS)) continue;\n  const hasNum = r.value_number !== null && r.value_number !== undefined && Number.isFinite(Number(r.value_number));\n  const hasStr = typeof r.value_string === 'string' && r.value_string.trim() !== '';\n  if (typeof DEFAULTS[key] === 'number') {\n    const v = hasNum ? Number(r.value_number) : (hasStr ? Number(r.value_string) : NaN);\n    if (Number.isFinite(v)) config[key] = v;\n    else warnings.push(`key \"${key}\" has no valid number: default ${DEFAULTS[key]} used`);\n  } else if (hasStr) {\n    config[key] = r.value_string.trim();\n  }\n}\nconfig.publish_slots_et = String(config.publish_slots_et).split(',').map(s => Number(s.trim())).filter(h => Number.isInteger(h) && h >= 0 && h <= 23);\nconfig.publish_enabled = config.publish_enabled ? 1 : 0;\nif (!config.ig_user_id) warnings.push('ig_user_id missing: publishing will fail');\n\nconst nyNow = $now.setZone('America/New_York');\nreturn [{\n  json: {\n    run_id: `pub-${nyNow.toFormat('yyyyMMdd-HHmm')}-${$execution.id}`,\n    started_at_ms: Date.now(),\n    ny_date: nyNow.toFormat('yyyy-MM-dd'),\n    ny_hour: nyNow.hour,\n    graph: `https://graph.instagram.com/${config.ig_api_version}`,\n    config_warnings: warnings,\n    config,\n  },\n}];\n"
      }
    },
    {
      "id": "1db44de1-49e8-4f3b-9d63-8e5f7b39a2bf",
      "name": "Get Posts",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        660,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "Ma6ybDlHtFNlE0BJ",
          "cachedResultName": "viral_posts"
        },
        "matchType": "anyCondition",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "READY"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "PUBLISHING"
            },
            {
              "keyName": "published_at",
              "condition": "gte",
              "keyValue": "={{ $now.minus({ hours: 48 }).toISO() }}"
            }
          ]
        },
        "returnAll": true
      },
      "notes": "READY + PUBLISHING posts and everything published in the last 48h.",
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "1ee94536-81bc-4a35-bf2c-bef89be4078a",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Decide — what the Publisher does this run. Pure rules, no AI. Output items (first one is the action):\n//  - resume:  a post left PUBLISHING by a previous run (Instagram was still processing the video)\n//  - publish: the best READY Reel, if the slot / daily cap / gap rules allow it (or the forced test post)\n//  - stale:   READY Reels too old for their trend (marked STALE so they stop blocking the Factory buffer)\n// 0 items = nothing to do.\n\nconst run = $('Init Publisher').first().json;\nconst cfg = run.config;\nconst nowMs = run.started_at_ms;\nconst posts = $input.all().map(i => i.json ?? {}).filter(p => p.post_key);\nconst ageH = iso => (nowMs - Date.parse(iso ?? '')) / 3.6e6;\nconst nyDate = iso => DateTime.fromISO(String(iso)).setZone('America/New_York').toFormat('yyyy-MM-dd');\nconst pick = p => ({\n  post_key: p.post_key, candidate_key: p.candidate_key, video_url: p.video_url, cover_url: p.cover_url,\n  caption: p.caption, ig_container_id: p.ig_container_id ?? null, title: p.title, creator_name: p.creator_name,\n});\n\nconst out = [];\nconst pending = posts.find(p => p.status === 'PUBLISHING' && p.ig_container_id);\nconst ready = posts.filter(p => p.status === 'READY' && p.video_url);\nconst stale = ready.filter(p => ageH(p.created_at) > cfg.publish_ready_max_age_h && p.post_key !== cfg.publish_force_post_key);\n// Test posts (forced by hand in the Factory) are never published automatically, only via publish_force_post_key\nconst isTest = p => String(p.status_reason ?? '').startsWith('forced');\nconst fresh = ready.filter(p => !stale.includes(p) && !isTest(p));\nconst published = posts.filter(p => p.status === 'PUBLISHED' && p.published_at);\nconst today = published.filter(p => nyDate(p.published_at) === run.ny_date).length;\nconst lastH = published.length ? Math.min(...published.map(p => ageH(p.published_at))) : Infinity;\n\nlet reason;\nif (pending) {\n  out.push({ json: { action: 'resume', ...pick(pending), reason: 'container still processing in a previous run' } });\n} else if (cfg.publish_force_post_key) {\n  const f = ready.find(p => p.post_key === cfg.publish_force_post_key);\n  if (f) out.push({ json: { action: 'publish', ...pick(f), reason: 'forced by publish_force_post_key' } });\n  else reason = `forced post ${cfg.publish_force_post_key} not READY (already published or missing): clear publish_force_post_key`;\n} else if (!cfg.publish_enabled) reason = 'publish_enabled = 0';\nelse if (!cfg.publish_slots_et.includes(run.ny_hour)) reason = `${run.ny_hour}:00 New York is not a slot (${cfg.publish_slots_et.join(', ')})`;\nelse if (today >= cfg.publish_max_per_day) reason = `daily cap reached (${today}/${cfg.publish_max_per_day})`;\nelse if (lastH < cfg.publish_min_gap_h) reason = `last post ${lastH.toFixed(1)}h ago (< ${cfg.publish_min_gap_h}h)`;\nelse if (!fresh.length) reason = 'no fresh READY Reel';\nelse {\n  fresh.sort((a, b) => (Number(b.trend_score) || 0) - (Number(a.trend_score) || 0) || Date.parse(b.created_at) - Date.parse(a.created_at));\n  out.push({ json: { action: 'publish', ...pick(fresh[0]), reason: `best of ${fresh.length} READY (score ${fresh[0].trend_score})` } });\n}\nif (reason) console.log('no publish:', reason);\nfor (const p of stale) out.push({ json: { action: 'stale', ...pick(p), reason: `READY for ${Math.round(ageH(p.created_at))}h` } });\nreturn out;\n"
      },
      "notes": "Slots, daily cap, gap, freshness. First item = action (publish/resume), then stale ones. 0 items = nothing to do."
    },
