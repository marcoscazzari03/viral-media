  "name": "00 - US VIRAL | Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "ca374ffa-555e-4f64-88df-fff7bc79a87d",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Format Error — turns the Error Trigger payload into a viral_runs row (status ERROR)\n// plus alert_text for the Telegram alert. Works for both execution errors and trigger errors.\n\nconst e = $input.first().json ?? {};\nconst exec = e.execution ?? {};\nconst trig = e.trigger ?? {};\nconst err = exec.error ?? trig.error ?? {};\nconst now = new Date().toISOString();\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst details = {\n  message: err.message ?? 'unknown error',\n  description: err.description ?? null,\n  node: exec.lastNodeExecuted ?? err.node?.name ?? null,\n  execution_id: exec.id ?? null,\n  execution_url: exec.url ?? null,\n  mode: exec.mode ?? trig.mode ?? null,\n  stack: String(err.stack ?? '').slice(0, 1500),\n};\nconst workflow = e.workflow?.name ?? 'unknown';\n\nconst alertText = [\n  '⚠️ <b>US VIRAL — errore</b>',\n  `<b>${esc(workflow)}</b>`,\n  `Nodo: ${esc(details.node ?? '-')}`,\n  esc(String(details.message).slice(0, 600)),\n  details.execution_url ? esc(details.execution_url) : '',\n].filter(Boolean).join('\\n');\n\nreturn [{\n  json: {\n    run_id: `err-${exec.id ?? Date.now()}`,\n    workflow,\n    started_at: now,\n    finished_at: now,\n    status: 'ERROR',\n    sources_polled: 0,\n    videos_fetched: 0,\n    new_candidates: 0,\n    updated_candidates: 0,\n    eligible: 0,\n    expired: 0,\n    rejected: 0,\n    quota_units_est: 0,\n    errors: JSON.stringify(details).slice(0, 4000),\n    alert_text: alertText,\n  },\n}];\n"
      },
      "id": "bb113016-4fa0-40b1-8cb2-34c888cf0c05",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
