      "parameters": {
        "jsCode": "// Build Run Log — one row for viral_runs: Reels measured and insights errors of this run.\n\nconst run = $('Init Analytics').first().json;\nconst rows = $('Map Metrics').all().map(i => i.json);\nconst errors = rows.filter(r => r.error).map(r => `${r.post_key}: ${r.error}`);\nconst account = $('Account Info').first().json;\nif (account.error) errors.push(`account: ${String(account.error.message ?? account.error).slice(0, 200)}`);\n\nreturn [{\n  json: {\n    run_id: run.run_id,\n    workflow: '04 - US VIRAL | Analytics',\n    started_at: run.started_at,\n    finished_at: new Date().toISOString(),\n    status: errors.length ? 'PARTIAL' : 'SUCCESS',\n    videos_fetched: rows.length,\n    errors: JSON.stringify({ errors, followers: account.followers_count ?? null }).slice(0, 4000),\n  },\n}];\n"
      },
