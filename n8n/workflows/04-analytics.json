    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Map YT Metrics — one snapshot row per Short found by YouTube (deleted / private ones are simply missing).\n\nconst run = $('Init Analytics').first().json;\nconst posts = $('YT Build Request').first().json.posts;\nconst stats = new Map(($input.first().json.items ?? []).map(v => [v.id, v.statistics ?? {}]));\nconst num = v => (v === undefined || v === null || !Number.isFinite(Number(v)) ? null : Number(v));\nconst nowIso = new Date().toISOString();\n\nreturn posts.filter(p => stats.has(p.yt_video_id)).map(p => {\n  const s = stats.get(p.yt_video_id);\n  const ageH = (Date.now() - Date.parse(p.published_at)) / 3.6e6;\n  return {\n    json: {\n      post_key: p.post_key,\n      platform: 'youtube',\n      platform_video_id: p.yt_video_id,\n      source_key: p.source_key,\n      captured_at: nowIso,\n      age_h: Number.isFinite(ageH) ? Math.round(ageH * 10) / 10 : null,\n      views: num(s.viewCount),\n      likes: num(s.likeCount),\n      comments: num(s.commentCount),\n      run_id: run.run_id,\n    },\n  };\n});\n"
      },
      "name": "Map YT Metrics",
      "type": "n8n-nodes-base.code",
