      "name": "YT Uploads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1104,
        800
      ],
      "onError": "continueRegularOutput",
      "notes": "Latest 25 uploads of our channel (manual and API). 1 quota unit.",
      "credentials": {
        "httpQueryAuth": {
          "id": "XLgg21h8Ot8uyTe7",
          "name": "US VIRAL - YouTube API Key"
        }
      },
      "id": "513b887a-661e-40a1-b158-6b228eb4cc0e"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// YT Match Uploads — links the Shorts uploaded by hand to their Reel, so nobody has to fill yt_video_id.\n// A Reel without yt_video_id gets the latest upload of our channel that (1) is not linked to another Reel,\n// (2) went up between 12h before and 72h after the Instagram post, and (3) mentions the meme line, the first\n// line of the caption (often used as title), the hook or the streamer. Best text match wins, then the closest in time.\n// Output: every post of Get Published (with the linked yt_video_id), link_new = true for the new links.\n\nconst posts = $('Get Published').all().map(i => ({ ...(i.json ?? {}) }));\nconst uploads = ($input.first().json.items ?? []).map(it => ({\n  id: it.snippet?.resourceId?.videoId ?? it.contentDetails?.videoId,\n  at: Date.parse(it.contentDetails?.videoPublishedAt ?? it.snippet?.publishedAt ?? ''),\n  text: `${it.snippet?.title ?? ''} ${it.snippet?.description ?? ''}`,\n})).filter(u => u.id && Number.isFinite(u.at));\n\nconst isYtId = v => /^[A-Za-z0-9_-]{11}$/.test(String(v ?? '').trim());\nconst norm = s => String(s ?? '').toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, ' ').trim();\nconst used = new Set(posts.filter(p => isYtId(p.yt_video_id)).map(p => String(p.yt_video_id).trim()));\n\nconst score = (p, u) => {\n  const t = ` ${norm(u.text)} `;\n  let s = 0;\n  const fields = { meme_caption: 3, caption_head: 3, hook: 2, title: 1 };\n  const vals = { ...p, caption_head: String(p.caption ?? '').split('\\n')[0] };\n  for (const [field, w] of Object.entries(fields)) {\n    const v = norm(vals[field]);\n    if (v.length >= 6 && t.includes(` ${v} `)) s = Math.max(s, w);\n  }\n  const creator = norm(p.creator_name);\n  if (creator && t.includes(` ${creator} `)) s += 1;\n  return s;\n};\n\nfor (const p of posts.sort((a, b) => Date.parse(a.published_at) - Date.parse(b.published_at))) {\n  if (isYtId(p.yt_video_id)) continue;\n  const pub = Date.parse(p.published_at);\n  if (!Number.isFinite(pub)) continue;\n  const best = uploads\n    .filter(u => !used.has(u.id) && u.at >= pub - 12 * 3.6e6 && u.at <= pub + 72 * 3.6e6)\n    .map(u => ({ u, s: score(p, u), d: Math.abs(u.at - pub) }))\n    .filter(x => x.s > 0)\n    .sort((a, b) => b.s - a.s || a.d - b.d)[0];\n  if (!best) continue;\n  used.add(best.u.id);\n  p.yt_video_id = best.u.id;\n  p.yt_published_at = new Date(best.u.at).toISOString();\n  p.link_new = true;\n}\n\nreturn posts.map(p => ({ json: p }));\n"
      },
      "name": "YT Match Uploads",
      "type": "n8n-nodes-base.code",
