      "parameters": {
        "jsCode": "// Init Analytics — run context + typed config (viral_config). Missing keys fall back to DEFAULTS.\n\nconst DEFAULTS = {\n  ig_user_id: '',\n  ig_api_version: 'v23.0',\n  analytics_track_days: 7,\n  yt_channel_handle: '@viralstreamersdaily',\n  ig_reel_metrics: 'views,reach,likes,comments,shares,saved,total_interactions,ig_reels_avg_watch_time,ig_reels_video_view_total_time',\n};\n\nconst config = { ...DEFAULTS };\nfor (const item of $input.all()) {\n  const r = item.json;\n  const key = String(r.key ?? '').trim();\n  if (!(key in DEFAULTS)) continue;\n  const hasNum = r.value_number !== null && r.value_number !== undefined && Number.isFinite(Number(r.value_number));\n  const hasStr = typeof r.value_string === 'string' && r.value_string.trim() !== '';\n  if (typeof DEFAULTS[key] === 'number') { if (hasNum) config[key] = Number(r.value_number); }\n  else if (hasStr) config[key] = r.value_string.trim();\n}\nconfig.ig_reel_metrics = config.ig_reel_metrics.split(',').map(s => s.trim()).filter(Boolean).join(',');\n\nreturn [{\n  json: {\n    run_id: `ana-${$now.toFormat('yyyyMMdd-HHmm')}-${$execution.id}`,\n    started_at: new Date().toISOString(),\n    graph: `https://graph.instagram.com/${config.ig_api_version}`,\n    config,\n  },\n}];\n"
      },
