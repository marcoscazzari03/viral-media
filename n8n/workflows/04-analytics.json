    {
      "parameters": {
        "jsCode": "// Map Metrics — one snapshot row per Reel from its insights response.\n// Values come as data[].values[0].value (or total_value.value); missing metrics stay null.\n\nconst run = $('Init Analytics').first().json;\nconst posts = $('Get Published').all();\nconst num = v => (v === undefined || v === null || !Number.isFinite(Number(v)) ? null : Number(v));\nconst nowIso = new Date().toISOString();\n\nreturn $input.all().map((it, i) => {\n  const post = posts[i]?.json ?? {};\n  const res = it.json ?? {};\n  const m = {};\n  for (const d of res.data ?? []) m[d.name] = num(d.values?.[0]?.value ?? d.total_value?.value);\n  const ageH = (Date.now() - Date.parse(post.published_at)) / 3.6e6;\n  return {\n    json: {\n      post_key: post.post_key,\n      ig_media_id: post.ig_media_id,\n      source_key: post.source_key,\n      captured_at: nowIso,\n      age_h: Number.isFinite(ageH) ? Math.round(ageH * 10) / 10 : null,\n      views: m.views ?? null,\n      reach: m.reach ?? null,\n      likes: m.likes ?? null,\n      comments: m.comments ?? null,\n      shares: m.shares ?? null,\n      saved: m.saved ?? null,\n      total_interactions: m.total_interactions ?? null,\n      avg_watch_ms: m.ig_reels_avg_watch_time ?? null,\n      total_watch_ms: m.ig_reels_video_view_total_time ?? null,\n      run_id: run.run_id,\n      error: res.error ? String(res.error.message ?? res.error).slice(0, 300) : '',\n    },\n  };\n});\n"
      },
