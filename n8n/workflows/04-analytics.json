    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// YT Build Request — the YouTube Shorts of the Reels published in the last analytics_track_days.\n// yt_video_id is set by 06 (YouTube Publisher) or by hand after a manual upload; anything that is not an\n// 11-char YouTube id (e.g. empty) is skipped. One videos.list call takes up to 50 ids.\n\nconst posts = $input.all()\n  .map(i => i.json ?? {})\n  .filter(p => /^[A-Za-z0-9_-]{11}$/.test(String(p.yt_video_id ?? '').trim()))\n  .slice(0, 50)\n  .map(p => ({ post_key: p.post_key, yt_video_id: String(p.yt_video_id).trim(), source_key: p.source_key,\n    published_at: p.yt_published_at || p.published_at }));\nif (!posts.length) return [];\nreturn [{ json: { ids: posts.map(p => p.yt_video_id).join(','), posts } }];\n"
      },
      "name": "YT Build Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "notes": "One YouTube call for all Shorts. 0 items = no Short to measure.",
      "id": "d6cb20a0-2154-48cc-a71e-16d29f3ec758",
      "position": [
        1552,
        800
