    {
      "id": "e15749c3-c343-4fd6-8d62-c5a6dd1bef0e",
      "name": "Pick for Facebook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Pick for Facebook — which Reel to publish on the Facebook Page this run. Pure rules, no AI.\n// Meta does not share API-published Instagram Reels to the Page, so we publish them there ourselves.\n//  - forced test post (fb_force_post_key): any READY/PUBLISHED post with a video, once, even if fb_enabled = 0;\n//  - otherwise, when fb_enabled = 1: the oldest Reel already PUBLISHED on Instagram in the last 48h and not yet on\n//    the Page (no fb_video_id, no fb_error).\n// 0 items = nothing to do.\n\nconst rows = $('Load Config').all().map(i => i.json ?? {});\nconst val = (key, def) => {\n  const r = rows.find(x => x.key === key);\n  if (!r) return def;\n  if (typeof def === 'number') return Number.isFinite(Number(r.value_number)) && r.value_number !== null ? Number(r.value_number) : def;\n  return (r.value_string ?? '').trim() || def;\n};\nconst cfg = {\n  enabled: val('fb_enabled', 0) ? 1 : 0,\n  pageId: val('fb_page_id', ''),\n  version: val('fb_api_version', 'v23.0'),\n  force: val('fb_force_post_key', ''),\n  chatId: val('telegram_chat_id', ''),\n};\nif (!cfg.pageId) {\n  console.log('fb_page_id missing in viral_config: nothing to do');\n  return [];\n}\n\nconst ageH = iso => (Date.now() - Date.parse(iso ?? '')) / 3.6e6;\nconst posts = $input.all().map(i => i.json ?? {}).filter(p => p.post_key && p.video_url);\n\nlet pick = null, reason = '';\nif (cfg.force) {\n  pick = posts.find(p => p.post_key === cfg.force && !p.fb_video_id && ['READY', 'PUBLISHED'].includes(p.status));\n  reason = pick ? 'forced by fb_force_post_key' : '';\n  if (!pick) console.log(`forced post ${cfg.force} not found or already on Facebook: clear fb_force_post_key`);\n}\nif (!pick && cfg.enabled) {\n  const queue = posts\n    .filter(p => p.status === 'PUBLISHED' && !p.fb_video_id && !p.fb_error && ageH(p.published_at) <= 48)\n    .sort((a, b) => Date.parse(a.published_at) - Date.parse(b.published_at));\n  pick = queue[0] ?? null;\n  reason = pick ? `oldest of ${queue.length} published on Instagram, not yet on Facebook` : '';\n}\nif (!pick) return [];\n\nconst clean = s => String(s ?? '').replace(/\\s+/g, ' ').trim();\nreturn [{\n  json: {\n    post_key: pick.post_key,\n    video_url: pick.video_url,\n    title: clean(pick.meme_caption || pick.hook || pick.title) || 'Streamer moment',\n    creator_name: clean(pick.creator_name),\n    description: String(pick.caption ?? '').trim().slice(0, 2000),\n    reason,\n    page_id: cfg.pageId,\n    graph: `https://graph.facebook.com/${cfg.version}`,\n    rupload: `https://rupload.facebook.com/video-upload/${cfg.version}`,\n    chat_id: cfg.chatId,\n  },\n}];\n"
      },
      "notes": "0 items = nothing to publish this run."
    },
