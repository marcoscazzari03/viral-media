# Copy to .env (scripts/install.sh does it and generates API_TOKEN automatically). Never commit .env.
DOMAIN=media.weborastudio.it
API_TOKEN=change-me
WHISPER_MODEL=small.en
RETENTION_DAYS=14
MAX_DOWNLOAD_MB=500
TTS_ENGINE=kokoro
KOKORO_VOICE=am_michael
SOURCE_HOSTS=youtube.com,youtu.be,twitch.tv,kick.com
MAX_CLIP_SECONDS=75
# Publishing page https://DOMAIN/panel (choose a long password)
PANEL_PASSWORD=
# TikTok app (developers.tiktok.com): Login Kit redirect URI = https://DOMAIN/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Control panel https://PORTAL_DOMAIN (DNS A record to this server first). Generate the 3 PORTAL_* secrets with:
#   docker compose run --rm portal python -m app.setup
PORTAL_DOMAIN=dashboard.weborastudio.it
PORTAL_PASSWORD_HASH=
PORTAL_SECRET=
PORTAL_TOTP_SECRET=
# n8n REST API (n8n: Settings > n8n API > Create API key). Base URL = the address of your n8n, without /api
N8N_BASE_URL=
N8N_API_KEY=
