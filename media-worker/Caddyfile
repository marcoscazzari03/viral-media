{$DOMAIN} {
	encode gzip

	# Rendered files (public, needed by the Instagram API): https://DOMAIN/files/<job_id>/reel.mp4
	handle_path /files/* {
		root * /srv/media/files
		file_server
	}

	# Public legal pages (required by the platform developer apps): https://DOMAIN/legal/privacy.html
	redir /legal /legal/
	handle /legal/* {
		root * /srv/site
		file_server
	}

	# Job API (protected by bearer token inside the app)
	handle {
		reverse_proxy worker:8000
	}
}
