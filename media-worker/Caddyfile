{$DOMAIN} {
	encode gzip

	# Rendered files (public, needed by the Instagram API): https://DOMAIN/files/<job_id>/reel.mp4
	handle_path /files/* {
		root * /srv/media/files
		file_server
	}

	# Public legal pages (required by the platform developer apps): https://DOMAIN/legal/privacy.html
	redir /legal /legal/
	handle /legal/* {
		root * /srv/site
		file_server
	}

	# Job API (protected by bearer token inside the app)
	handle {
		reverse_proxy worker:8000
	}
}

# Private control panel (login + 2FA inside the app). Needs a DNS A record PORTAL_DOMAIN -> this server.
{$PORTAL_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	reverse_proxy portal:8080
}
